        <xf:button href="{{ link('wrxt-sss-kategoriler/sort') }}">{{ phrase('wrxt_sss_i18n_drag_and_drop_to_reorder') }}</xf:button>
        <xf:button href="{{ link('wrxt-sss-sorular') }}">{{ phrase('admin_navigation.wrxtSssFaqs') }}</xf:button>
