<?xml version="1.0" encoding="utf-8"?>
<templates>
  <template type="public" title="wrxt_sss_index" version_id="1010100" version_string="1.1.1"><![CDATA[<xf:title>{$pageTitle}</xf:title>
<xf:page option="section">wrxtSss</xf:page>
<xf:css src="wrxt_sss.less" />
<div data-wrxt-sss-root="1" data-exclusive="{$xf.options.wrxtSssExclusiveOpen}">
<div class="block"><div class="block-container"><div class="block-body"><div class="block-row"><div class="contentRow"><div class="contentRow-main"><h1 class="contentRow-title">{$pageTitle}</h1><xf:if is="$pageDescription"><div class="contentRow-minor">{$pageDescription}</div></xf:if></div></div></div>
<xf:if is="$xf.options.wrxtSssSearchEnabled || $xf.options.wrxtSssOpenCloseButtons"><div class="block-row wrxtSss-tools"><xf:if is="$xf.options.wrxtSssSearchEnabled"><input class="input" type="search" data-wrxt-sss-search="1" placeholder="{{ phrase('wrxt_sss_search_placeholder') }}" autocomplete="off" /><xf:else /><span></span></xf:if><xf:if is="$xf.options.wrxtSssOpenCloseButtons"><div class="buttonGroup"><button type="button" class="button button--link" data-wrxt-sss-open="1">{{ phrase('wrxt_sss_open_all') }}</button><button type="button" class="button button--link" data-wrxt-sss-close="1">{{ phrase('wrxt_sss_close_all') }}</button></div></xf:if></div></xf:if></div></div></div>
<xf:if is="$groups is not empty"><xf:foreach loop="$groups" value="$group"><div class="block wrxtSss-category" data-wrxt-sss-category="1"><div class="block-container"><h2 class="block-header"><xf:if is="$group.category.icon"><i class="fa--xf far {$group.category.icon}" aria-hidden="true"></i></xf:if> {$group.category.title}</h2><xf:if is="$group.category.description"><div class="block-row block-row--minor">{$group.category.description}</div></xf:if><div class="block-body"><xf:foreach loop="$group.faqs" value="$faq"><details class="wrxtSss-item" id="{$faq.anchor}" data-wrxt-sss-item="1"><summary class="block-row wrxtSss-question"><span>{$faq.question}</span><span class="wrxtSss-labels"><xf:if is="$faq.is_featured"><span class="label label--primary">{{ phrase('wrxt_sss_i18n_featured') }}</span></xf:if><xf:if is="$badgeCutoff && $faq.created_date >= $badgeCutoff"><span class="label label--green">{{ phrase('wrxt_sss_i18n_new') }}</span><xf:elseif is="$badgeCutoff && $faq.updated_date >= $badgeCutoff && $faq.updated_date > $faq.created_date" /><span class="label label--accent">{{ phrase('wrxt_sss_i18n_updated') }}</span></xf:if></span></summary><div class="block-row block-row--separated wrxtSss-answer"><div class="bbWrapper">{{ bb_code($faq.answer, 'wrxt_sss', $faq) }}</div><xf:if is="$xf.options.wrxtSssShowPermalinks"><div class="wrxtSss-permalink"><a href="#{$faq.anchor}">{{ phrase('wrxt_sss_i18n_direct_link') }}</a></div></xf:if></div></details></xf:foreach></div></div></div></xf:foreach><div class="block" data-wrxt-sss-no-results="1" hidden><div class="block-container"><div class="block-body"><div class="block-row">{{ phrase('wrxt_sss_i18n_no_faq_entry_matched_your_search') }}</div></div></div></div><xf:else /><div class="block"><div class="block-container"><div class="block-body"><div class="block-row">{{ phrase('wrxt_sss_empty') }}</div></div></div></div></xf:if>
</div>
<xf:js>
(() => { const root=document.querySelector('[data-wrxt-sss-root="1"]'); if(!root)return; const items=[...root.querySelectorAll('[data-wrxt-sss-item="1"]')],cats=[...root.querySelectorAll('[data-wrxt-sss-category="1"]')],search=root.querySelector('[data-wrxt-sss-search="1"]'),none=root.querySelector('[data-wrxt-sss-no-results="1"]'),exclusive=root.dataset.exclusive==='1'; const openHash=()=>{if(!location.hash)return;const target=document.getElementById(decodeURIComponent(location.hash.slice(1)));if(target&&target.matches('details')){if(exclusive)items.forEach(x=>{if(x!==target)x.open=false});target.open=true;requestAnimationFrame(()=>target.scrollIntoView({block:'center'}));}}; const filter=()=>{const q=(search?.value||'').trim().toLocaleLowerCase('tr-TR');let visible=0;items.forEach(item=>{const show=!q||item.textContent.toLocaleLowerCase('tr-TR').includes(q);item.hidden=!show;if(show)visible++;});cats.forEach(cat=>{cat.hidden=!cat.querySelector('[data-wrxt-sss-item="1"]:not([hidden])')});if(none)none.hidden=visible!==0;}; if(exclusive)items.forEach(item=>item.addEventListener('toggle',()=>{if(item.open)items.forEach(other=>{if(other!==item)other.open=false})})); search?.addEventListener('input',filter); root.querySelector('[data-wrxt-sss-open="1"]')?.addEventListener('click',()=>{if(exclusive){const first=items.find(x=>!x.hidden);if(first)first.open=true}else items.filter(x=>!x.hidden).forEach(x=>x.open=true)}); root.querySelector('[data-wrxt-sss-close="1"]')?.addEventListener('click',()=>items.forEach(x=>x.open=false)); window.addEventListener('hashchange',openHash);openHash(); })()
</xf:js>]]></template>

  <template type="public" title="wrxt_sss.less" version_id="1010100" version_string="1.1.1"><![CDATA[.wrxtSss-tools{display:flex;gap:@xf-paddingMedium;align-items:center;justify-content:space-between}.wrxtSss-tools .input{max-width:520px}.wrxtSss-category .block-header .fa{margin-right:@xf-paddingSmall}.wrxtSss-item{border-top:1px solid @xf-borderColorLight}.wrxtSss-item:first-child{border-top:0}.wrxtSss-question{cursor:pointer;display:flex;align-items:center;justify-content:space-between;gap:@xf-paddingMedium;font-weight:600}.wrxtSss-question::marker{color:@xf-textColorMuted}.wrxtSss-labels{display:inline-flex;flex-wrap:wrap;gap:4px;justify-content:flex-end}.wrxtSss-answer{background:@xf-contentAltBg}.wrxtSss-answer .bbWrapper>:first-child{margin-top:0}.wrxtSss-answer .bbWrapper>:last-child{margin-bottom:0}.wrxtSss-permalink{margin-top:@xf-paddingMedium;font-size:@xf-fontSizeSmaller}@media(max-width:@xf-responsiveMedium){.wrxtSss-tools{align-items:stretch;flex-direction:column}.wrxtSss-tools .input{max-width:none}.wrxtSss-question{align-items:flex-start}}]]></template>

  <template type="public" title="wrxt_sss_widget" version_id="1010100" version_string="1.1.1"><![CDATA[<div class="block"{{ widget_data($widget) }}><div class="block-container"><h3 class="block-minorHeader">{$title}</h3><div class="block-body"><xf:foreach loop="$faqs" value="$faq"><div class="block-row"><a href="{{ link('sss') }}#{$faq.anchor}">{$faq.question}</a></div></xf:foreach></div><div class="block-footer"><a href="{{ link('sss') }}">{{ phrase('wrxt_sss_i18n_view_all_frequently_asked_questions') }}</a></div></div></div>]]></template>

  <template type="admin" title="widget_def_options_wrxt_sss_faq" version_id="1010100" version_string="1.1.1"><![CDATA[<xf:numberboxrow name="options[limit]" value="{$options.limit}" min="1" max="20" label="{{ phrase('wrxt_sss_i18n_number_of_questions_to_display') }}" /><xf:checkboxrow><xf:option name="options[featured_only]" selected="$options.featured_only">{{ phrase('wrxt_sss_i18n_show_featured_faq_entries_only') }}</xf:option></xf:checkboxrow>]]></template>

  <template type="admin" title="wrxt_sss_admin_category_list" version_id="1010100" version_string="1.1.1"><![CDATA[<xf:title>{{ phrase('admin_navigation.wrxtSssCategories') }}</xf:title>
