    </div>
</xf:pageaction>

<xf:if is="$categoryRows is not empty">
    <div class="block">
        <div class="block-container">
            <div class="block-body">
                <xf:datalist data-xf-init="responsive-data-list">
                    <xf:datarow rowtype="header">
                        <xf:cell>{{ phrase('wrxt_sss_i18n_category') }}</xf:cell>
                        <xf:cell>{{ phrase('wrxt_sss_i18n_order') }}</xf:cell>
                        <xf:cell>{{ phrase('wrxt_sss_i18n_question') }}</xf:cell>
                        <xf:cell>{{ phrase('wrxt_sss_i18n_status') }}</xf:cell>
                        <xf:cell></xf:cell>
                    </xf:datarow>
                    <xf:foreach loop="$categoryRows" value="$row">
                        <xf:datarow>
                            <xf:cell href="{{ link('wrxt-sss-kategoriler/edit', null, {'category_id': $row.category.category_id}) }}" class="dataList-cell--link dataList-cell--main">
                                <div class="dataList-mainRow"><strong>{$row.category.title}</strong></div>
                                <xf:if is="$row.category.description || $row.category.allowed_user_group_ids">
                                    <div class="dataList-secondRow">{$row.category.description}<xf:if is="$row.category.allowed_user_group_ids"> · Grup kısıtlı</xf:if></div>
                                </xf:if>
                            </xf:cell>
                            <xf:cell>{$row.category.display_order}</xf:cell>
                            <xf:cell>{$row.faqCount}</xf:cell>
                            <xf:cell><xf:if is="$row.category.is_active"><span class="label label--green">{{ phrase('wrxt_sss_i18n_active') }}</span><xf:else /><span class="label">{{ phrase('wrxt_sss_i18n_inactive') }}</span></xf:if></xf:cell>
                            <xf:delete href="{{ link('wrxt-sss-kategoriler/delete', null, {'category_id': $row.category.category_id}) }}" />
                        </xf:datarow>
                    </xf:foreach>
                </xf:datalist>
            </div>
        </div>
    </div>
<xf:else />
    <div class="blockMessage">{{ phrase('wrxt_sss_i18n_no_faq_category_has_been_created_yet') }}</div>
</xf:if>]]></template>

  <template type="admin" title="wrxt_sss_admin_category_edit" version_id="1010100" version_string="1.1.1"><![CDATA[<xf:title><xf:if is="$category.exists">{{ phrase('wrxt_sss_i18n_edit_faq_category') }}<xf:else />{{ phrase('wrxt_sss_i18n_add_faq_category') }}</xf:if></xf:title><xf:form action="{{ link('wrxt-sss-kategoriler/save') }}" ajax="true" class="block"><div class="block-container"><div class="block-body"><xf:hiddenval name="category_id" value="{$category.category_id}" /><xf:textboxrow name="title" value="{$category.title}" maxlength="100" label="{{ phrase('wrxt_sss_i18n_category_name') }}" required="true" /><xf:textboxrow name="description" value="{$category.description}" maxlength="255" label="{{ phrase('wrxt_sss_i18n_description') }}" /><xf:textboxrow name="icon" value="{$category.icon}" maxlength="64" label="{{ phrase('wrxt_sss_i18n_font_awesome_icon') }}" explain="{{ phrase('wrxt_sss_i18n_example_fa_circle_question_you_may_leave_this_blan') }}" /><xf:selectrow name="allowed_user_group_ids" multiple="true" value="{$allowedGroupIds}" label="{{ phrase('wrxt_sss_i18n_user_groups_that_can_view') }}" explain="{{ phrase('wrxt_sss_i18n_if_no_selection_is_made_anyone_with_faq_view_permi') }}"><xf:foreach loop="$userGroups" value="$userGroup"><xf:option value="{$userGroup.user_group_id}">{$userGroup.title}</xf:option></xf:foreach></xf:selectrow><xf:numberboxrow name="display_order" value="{$category.display_order}" min="0" label="{{ phrase('wrxt_sss_i18n_display_order') }}" /><xf:checkboxrow><xf:option name="is_active" selected="$category.is_active">{{ phrase('wrxt_sss_i18n_category_active') }}</xf:option></xf:checkboxrow></div><xf:submitrow submit="{{ phrase('wrxt_sss_i18n_save') }}" /></div></xf:form>]]></template>

  <template type="admin" title="wrxt_sss_admin_category_delete" version_id="1010100" version_string="1.1.1"><![CDATA[<xf:title>{{ phrase('wrxt_sss_i18n_delete_faq_category') }}</xf:title><xf:form action="{{ link('wrxt-sss-kategoriler/delete') }}" ajax="true" class="block"><div class="block-container"><div class="block-body"><xf:hiddenval name="category_id" value="{$category.category_id}" /><div class="block-row">“<strong>{$category.title}</strong>” kategorisini silmek istediğinizden emin misiniz?<xf:if is="$faqCount"><br /><br /><span class="u-muted">Bu kategoriyle birlikte {$faqCount} SSS kaydı da silinecek.</span></xf:if></div></div><xf:submitrow submit="{{ phrase('wrxt_sss_i18n_delete') }}" rowtype="simple" /></div></xf:form>]]></template>

  <template type="admin" title="wrxt_sss_admin_category_sort" version_id="1010100" version_string="1.1.1"><![CDATA[<xf:title>{{ phrase('wrxt_sss_i18n_reorder_faq_categories') }}</xf:title><xf:css src="wrxt_sss_admin.less" /><xf:form action="{{ link('wrxt-sss-kategoriler/sort-save') }}" ajax="true" class="block"><div class="block-container"><div class="block-body wrxtSss-sortList" data-wrxt-sort-list="1"><xf:foreach loop="$categories" value="$category"><div class="block-row wrxtSss-sortRow" draggable="true"><input type="hidden" name="order[]" value="{$category.category_id}" /><span class="wrxtSss-sortHandle"><i class="fa--xf fas fa-grip-vertical"></i></span><strong>{$category.title}</strong></div></xf:foreach></div><xf:submitrow submit="{{ phrase('wrxt_sss_i18n_save_order') }}" /></div></xf:form><xf:js>document.querySelectorAll('[data-wrxt-sort-list="1"]').forEach(list=>{let drag=null;list.querySelectorAll('.wrxtSss-sortRow').forEach(row=>{row.addEventListener('dragstart',()=>{drag=row;row.classList.add('is-dragging')});row.addEventListener('dragend',()=>{row.classList.remove('is-dragging');drag=null});row.addEventListener('dragover',e=>{e.preventDefault();if(!drag||drag===row)return;const r=row.getBoundingClientRect();list.insertBefore(drag,e.clientY<r.top+r.height/2?row:row.nextSibling)})})});</xf:js>]]></template>

